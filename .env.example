# ---------------------------------------------------------------
# Ritan Foods — environment
# Leave the service keys empty to run the full site in demo mode
# (in-memory catalogue, simulated payments, emails logged to console).
# ---------------------------------------------------------------

# Canonical URL (production: https://ritanfoods.co.in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — https://supabase.com (free tier). Project Settings > API
# Setup: SQL editor → run supabase/migrations/0001_init.sql, then supabase/seed.sql
#        (regenerate the seed from the catalogue with `npm run db:seed`).
#        Auth > URL configuration: Site URL = NEXT_PUBLIC_SITE_URL, add <site>/auth/callback as a redirect URL.
#        Sign up on the site with the owner's email, then make it admin:
#        update public.profiles set role = 'admin' where email = '<owner email>';
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — Dashboard > Settings > API Keys (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<site>/api/webhooks/razorpay, events payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Resend — https://resend.com (free: 3,000 emails/month). Verify the domain via GoDaddy DNS.
RESEND_API_KEY=
EMAIL_FROM="Ritan Foods <orders@ritanfoods.co.in>"
ADMIN_EMAIL=ritanfoods.co.in@gmail.com

# Signs demo-mode session cookies. Any long random string.
AUTH_SECRET=

# Demo-mode admin (only used when Supabase is NOT configured)
DEMO_ADMIN_EMAIL=admin@ritanfoods.test
DEMO_ADMIN_PASSWORD=

# Show sample reviews in production (keep false at launch)
NEXT_PUBLIC_SHOW_DEMO_CONTENT=false
